/*
 * Phase 2 — DevSecOps Pipeline
 * Adds:
 *   - SonarQube SAST scan  (static code analysis)
 *   - Trivy image scan      (container vulnerability scan)
 *
 * Prerequisites:
 *   1. SonarQube running at http://sonarqube:9000 (via docker-compose)
 *   2. Jenkins credential "sonarqube-token" = SonarQube user token
 *   3. Trivy installed in Jenkins container (see README bootstrap command)
 */

pipeline {
    agent any

    environment {
        IMAGE_NAME      = "flask-devsecops"
        IMAGE_TAG       = "${env.BUILD_NUMBER}"
        CONTAINER       = "flask-app"
        APP_PORT        = "5000"
        SONAR_HOST_URL  = "http://sonarqube:9000"
        SONAR_PROJECT   = "flask-devsecops"
        TRIVY_SEVERITY  = "HIGH,CRITICAL"        // fail only on these
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: "10"))
        timestamps()
        timeout(time: 30, unit: "MINUTES")
    }

    stages {

        stage("Checkout") {
            steps {
                echo "──── Checking out source code ────"
                checkout scm
            }
        }

        stage("Install dependencies") {
            steps {
                sh """
                    python3 -m venv .venv
                    . .venv/bin/activate
                    pip install --quiet --upgrade pip
                    pip install --quiet -r requirements.txt
                """
            }
        }

        stage("Run unit tests") {
            steps {
                sh """
                    . .venv/bin/activate
                    pytest app/test_app.py \
                        --tb=short \
                        --cov=app \
                        --cov-report=xml:coverage.xml \
                        -v
                """
            }
            post {
                always {
                    archiveArtifacts artifacts: "coverage.xml", allowEmptyArchive: true
                }
            }
        }

        // ── SAST: SonarQube ──────────────────────────────────────────────────
        stage("SonarQube SAST scan") {
            steps {
                echo "──── Running SonarQube static analysis ────"
                withCredentials([string(credentialsId: "sonarqube-token", variable: "SONAR_TOKEN")]) {
                    sh """
                        . .venv/bin/activate
                        sonar-scanner \
                            -Dsonar.projectKey=${SONAR_PROJECT} \
                            -Dsonar.sources=app \
                            -Dsonar.python.coverage.reportPaths=coverage.xml \
                            -Dsonar.host.url=${SONAR_HOST_URL} \
                            -Dsonar.token=\$SONAR_TOKEN
                    """
                }
            }
        }

        stage("SonarQube Quality Gate") {
            steps {
                echo "──── Checking SonarQube Quality Gate ────"
                timeout(time: 5, unit: "MINUTES") {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        // ── Build ────────────────────────────────────────────────────────────
        stage("Build Docker image") {
            steps {
                echo "──── Building Docker image: ${IMAGE_NAME}:${IMAGE_TAG} ────"
                sh "docker build -t ${IMAGE_NAME}:${IMAGE_TAG} -t ${IMAGE_NAME}:latest ."
            }
        }

        // ── SAST: Trivy image scan ───────────────────────────────────────────
        stage("Trivy image scan") {
            steps {
                echo "──── Scanning image for vulnerabilities (${TRIVY_SEVERITY}) ────"
                sh """
                    # Generate JSON report (always, even on vuln found)
                    trivy image \
                        --exit-code 0 \
                        --severity ${TRIVY_SEVERITY} \
                        --format json \
                        --output trivy-report.json \
                        ${IMAGE_NAME}:${IMAGE_TAG}

                    # Print human-readable table to console
                    trivy image \
                        --exit-code 1 \
                        --severity ${TRIVY_SEVERITY} \
                        --format table \
                        ${IMAGE_NAME}:${IMAGE_TAG}
                """
            }
            post {
                always {
                    archiveArtifacts artifacts: "trivy-report.json", allowEmptyArchive: true
                }
                failure {
                    echo "Trivy found ${TRIVY_SEVERITY} vulnerabilities — pipeline aborted"
                }
            }
        }

        // ── Deploy ───────────────────────────────────────────────────────────
        stage("Deploy container") {
            steps {
                sh """
                    docker rm -f ${CONTAINER} 2>/dev/null || true

                    docker run -d \
                        --name ${CONTAINER} \
                        --restart unless-stopped \
                        -p ${APP_PORT}:5000 \
                        -e APP_VERSION=${IMAGE_TAG} \
                        -e ENV=production \
                        ${IMAGE_NAME}:${IMAGE_TAG}
                """
            }
        }

        stage("Smoke test") {
            steps {
                sh """
                    sleep 5
                    STATUS=\$(curl -s -o /dev/null -w "%{http_code}" http://localhost:${APP_PORT}/health)
                    if [ "\$STATUS" -ne 200 ]; then
                        echo "Smoke test FAILED — HTTP \$STATUS"
                        exit 1
                    fi
                    echo "Smoke test PASSED — HTTP \$STATUS"
                """
            }
        }
    }

    post {
        success {
            echo "DevSecOps pipeline SUCCESS — image scanned, code analysed, app deployed"
        }
        failure {
            echo "Pipeline FAILED — check SonarQube / Trivy / test logs above"
            sh "docker rm -f ${CONTAINER} 2>/dev/null || true"
        }
        cleanup {
            sh "docker image prune -f"
        }
    }
}
